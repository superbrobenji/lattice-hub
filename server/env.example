# Serial port configuration
SERIAL_PORT=/dev/ttyUSB0
BAUD_RATE=115200

# Dual-master failover (optional)
DUAL_MASTER_ENABLED=false
SERIAL_PORT_SECONDARY=

# Master identity — required for node enrollment against real firmware.
# Path to the master's persisted Curve25519 keypair (JSON). Auto-generated at this path on
# first run if the file doesn't exist — no manual setup needed for this one.
MASTER_KEY_PATH=data/masterkey.json
# Physical WiFi MAC of the master ESP32, e.g. aa:bb:cc:dd:ee:ff. Left unset, JOIN_ACK's origin
# MAC stays all-zero and firmware rejects every enrollment.
MASTER_MAC=

# Secondary master identity — only read when DUAL_MASTER_ENABLED=true above.
# Path to the secondary master's persisted keypair (JSON). Auto-generated at this path on first
# run if the file doesn't exist.
SECONDARY_MASTER_KEY_PATH=data/masterkey-secondary.json
# Physical WiFi MAC of the secondary master ESP32. Left unset in dual-master mode, the secondary
# MAC/public-key fields are silently omitted from JOIN_ACK.
SECONDARY_MASTER_MAC=

# API configuration
API_PORT=8080
API_KEY=change-me-before-deploy
# Admin tier — enrollment approve/reject and hard deletes. May differ from API_KEY.
ADMIN_KEY=change-me-too-before-deploy

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Kafka
KAFKA_BROKER=kafka:9092
KAFKA_GROUP_ID=1

# Data persistence paths (relative to working directory)
AUTH_REGISTRY_PATH=data/nodeauth.json
NODE_REGISTRY_PATH=data/nodes.json
ZONE_REGISTRY_PATH=data/zones.json

# Logging: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
